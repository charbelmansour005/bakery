# MongoDB connection string (Atlas or self-hosted). The database name is part of the URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bakery?appName=Cluster0

# Seeded admin account. The password is bcrypt-hashed by `npm run seed` and never stored in plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session JWT. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Optional: WhatsApp number that "Review Order" opens, international format, digits only.
# Defaults to the value in lib/config.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=96171862139

# Set automatically by Vercel when a Blob store is connected to the project.
# CMS image uploads go to Vercel Blob when either of these is present; when both
# are absent (local dev) they are written to ./uploads and served by /api/media.
# A classic connection sets BLOB_READ_WRITE_TOKEN; an OIDC connection sets
# BLOB_STORE_ID instead (put() then authenticates with VERCEL_OIDC_TOKEN, which
# Vercel injects at runtime). Leave all unset locally.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Nodemailer SMTP, used to send customer sign-in codes.
# With SMTP_HOST unset, development prints the code to the server console
# instead of sending; production refuses to start a sign-in without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional. Must be an address your SMTP provider lets you send as — usually
# the same as SMTP_USER. Defaults to "La Belle Fournée <SMTP_USER>".
# SMTP_FROM="La Belle Fournée <you@example.com>"

# Whish Money online payments. With any of the four WHISH_* values missing,
# online payment is off and the site takes orders over WhatsApp only.
# Sandbox and live differ only by these values — nothing else changes.
#   WHISH_BASE_URL     the Whish API base (not the marketing site), from Whish
#   WHISH_CHANNEL      channel id issued by Whish
#   WHISH_SECRET       secret issued by Whish — never commit it or paste it anywhere
#   WHISH_WEBSITE_URL  the merchant website exactly as registered with Whish
# Check them with `npm run whish:check` before taking a payment.
WHISH_BASE_URL=
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=

# The site's public origin, used to build the URLs Whish calls and redirects to.
# Set it in production to the canonical host (the bare domain redirects to www,
# and Whish's server-to-server callback should not have to follow a redirect).
# Unset locally: the origin of the request is used.
# SITE_URL=https://www.labellefournee.com

# Where "new paid order" emails go. Defaults to SMTP_USER.
# ORDER_NOTIFY_EMAIL=
